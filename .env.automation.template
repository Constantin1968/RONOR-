###############################################################################
# .env.automation — șablon DERIVAT DIN COD
#
# Sursă: scripts/automation-preflight.sh și docker-compose.automation.yml
#        din Constantin1968/RONOR- @ 0f80a60
#
# ATENȚIE: acest fișier NU există în repo. Repo-ul conține doar .env.example și
# .env.production.template. Șablonul de mai jos este reconstruit prin extragerea
# variabilelor efectiv citite de preflight și de compose — nu din memorie.
#
# Variabilele marcate [OBLIGATORIU] sunt cerute cu `${VAR:?}` în preflight:
# scriptul se oprește imediat dacă lipsesc.
###############################################################################

# --- Verificate de automation-preflight.sh (liniile 16-24, 68-69) ------------

# [OBLIGATORIU] Directorul cu cele 13 secrete. Fiecare fișier trebuie să aibă
# owner:group 10001:10001 și permisiuni care satisfac
#   (mode & 0137) == 0  &&  (mode & 0400) != 0
# Practic: 0640 trece. 0644 și 0660 sunt respinse.
RONOR_AUTOMATION_SECRET_DIR=/srv/ronor/automation/secrets

# [OBLIGATORIU] Worktree-ul dedicat automatizării. Trebuie să existe fizic
# (`realpath -e`), deci creează-l înainte de a rula preflight.
RONOR_AUTOMATION_WORKTREE=/srv/ronor/automation/worktree

# [OBLIGATORIU] Origin-ul așteptat. Preflight compară exact, șir cu șir
# (linia 68), cu ce returnează `git remote get-url origin` în worktree.
# Trebuie să fie IDENTIC cu valoarea folosită de bootstrap la clonare — forma
# SSH și forma HTTPS nu sunt interschimbabile aici. Bootstrap-ul folosește în
# exemplul lui forma SSH; păstrează aceeași formă în ambele locuri.
# Include cratima finală din numele repo-ului.
RONOR_AUTOMATION_EXPECTED_ORIGIN=git@github.com:Constantin1968/RONOR-.git
# Alternativă, dacă worktree-ul e clonat pe HTTPS:
# RONOR_AUTOMATION_EXPECTED_ORIGIN=https://github.com/Constantin1968/RONOR-.git

# [OBLIGATORIU] Commit-ul aprobat. Preflight cere ca HEAD-ul worktree-ului să
# fie EXACT acesta (linia 69). Valoarea curentă a lui main după merge-ul PR #22:
RONOR_AUTOMATION_EXPECTED_HEAD=0f80a60886abeca5f2205ed0fcef7ce908706933

# [OBLIGATORIU] Calea absolută către acest fișier. Trebuie să existe.
RONOR_AUTOMATION_ENV_FILE=/srv/ronor/automation/.env.automation

# --- Citite de docker-compose.automation.yml ---------------------------------

# Tag-ul imaginilor. Implicit `local` dacă e gol (liniile 11, 68, 201).
RONOR_AUTOMATION_IMAGE_TAG=local

# Rădăcina artefactelor și directorul de nonce pentru atestare.
RONOR_AUTOMATION_ARTIFACT_ROOT=/srv/ronor/automation/artifacts
RONOR_AUTOMATION_NONCE_DIR=/srv/ronor/automation/nonces

# Imaginea de bază a runtime-ului.
RONOR_AUTOMATION_RUNTIME_BASE_IMAGE=node:22-bookworm-slim

# Comenzile de test, ca JSON. Schema a fost validată empiric: array de obiecte.
RONOR_AUTOMATION_TEST_COMMANDS_JSON=[{"name":"jest","command":["npm","test"]}]

# --- Gateway de modele ------------------------------------------------------

# URL-ul gateway-ului Portkey de pe Hetzner, văzut din rețeaua de egress.
RONOR_MODEL_GATEWAY_BASE_URL=http://model-egress-proxy:3004

# Implicit `false` în compose (linia 49). Pune `true` NUMAI dacă URL-ul de mai
# sus este el însuși o adresă Tailscale. Altfel lasă false.
RONOR_MODEL_GATEWAY_ALLOW_TAILSCALE=false

# --- Modele și cost ---------------------------------------------------------

# Implementer pe Contabo (Ollama :11434).
RONOR_OPENHANDS_LLM_MODEL=qwen2.5:72b-instruct-q4_K_M

# Verifier pe Contabo.
RONOR_CODEX_MODEL=deepseek-r1:70b-llama-distill-q4_K_M

# Rate amortizate pentru verifier-ul self-hosted. NU le lăsa 0 — plafoanele de
# cost din mandat devin decorative și bucla rămâne fără frână economică.
# Valori de pornire rezonabile pentru un 70B cuantizat pe hardware propriu:
RONOR_CODEX_INPUT_USD_PER_MTOK=0.15
RONOR_CODEX_OUTPUT_USD_PER_MTOK=0.60

###############################################################################
# PRECONDIȚIE CARE NU SE POATE AUTOMATIZA
#
# automation-preflight.sh linia 32 cere ca 11 tokenuri să fie distincte două
# câte două (verificat prin SHA-256, liniile 45-47):
#
#   langgraph_token            openhands_session_key      openhands_llm_api_key
#   openhands_secret_key       openhands_bridge_token     automation_capability_key
#   codex_verifier_token       codex_api_key              model_gateway_upstream_token
#   assurance_token            evidence_runner_token
#
# Bootstrap-ul generează 10 dintre ele. `model_gateway_upstream_token` NU e
# generat, pentru că este cheia reală a upstream-ului Portkey — o valoare random
# ar trece verificarea de unicitate și ar eșua abia la primul apel de model.
#
# Trebuie să o pui manual, ÎNAINTE de preflight:
#   printf '%s' "<cheia_portkey>" > $RONOR_AUTOMATION_SECRET_DIR/model_gateway_upstream_token
#   chown 10001:10001 $RONOR_AUTOMATION_SECRET_DIR/model_gateway_upstream_token
#   chmod 0640        $RONOR_AUTOMATION_SECRET_DIR/model_gateway_upstream_token
#
# Fără ea preflight cade la „service tokens are pairwise distinct".
###############################################################################
