RONOR_AUTOMATION_IMAGE_TAG=development-__REVISION__
RONOR_DEVELOPMENT_IMAGE_TAG=__REVISION__
RONOR_AUTOMATION_SECRET_DIR=/srv/ronor/development-automation/secrets
RONOR_DEVELOPMENT_SECRET_DIR=/srv/ronor/development-automation/secrets
RONOR_AUTOMATION_WORKTREE=/srv/ronor/development-automation/worktree
RONOR_AUTOMATION_ARTIFACT_ROOT=/srv/ronor/development-automation/artifacts
RONOR_AUTOMATION_NONCE_DIR=/srv/ronor/development-automation/nonces
RONOR_DEVELOPMENT_DATA_DIR=/srv/ronor/development-automation/data
RONOR_DEVELOPMENT_DEPENDENCIES=/srv/ronor/development-automation/dependencies
RONOR_AUTOMATION_BRANCH=automation/development-001
RONOR_AUTOMATION_EXPECTED_HEAD=__COMMIT__
RONOR_AUTOMATION_MAX_COST_USD=1
RONOR_AUTOMATION_MAX_RUNTIME_MINUTES=15
RONOR_AUTOMATION_MAX_FIX_CYCLES=1
RONOR_OPENHANDS_LLM_MODEL=openai/qwen3.8-max
RONOR_CODEX_MODEL=qwen3.8-max
RONOR_CODEX_INPUT_USD_PER_MTOK=0.87
RONOR_CODEX_OUTPUT_USD_PER_MTOK=1.74
RONOR_MODEL_GATEWAY_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
RONOR_MODEL_GATEWAY_ALLOW_TAILSCALE=false
RONOR_AUTOMATION_LANGGRAPH_HOST_PORT=3324
RONOR_AUTOMATION_OPENHANDS_BRIDGE_HOST_PORT=3301
RONOR_AUTOMATION_CODEX_VERIFIER_HOST_PORT=3302
RONOR_AUTOMATION_ASSURANCE_HOST_PORT=3303
RONOR_AUTOMATION_TEST_COMMANDS_JSON='[{"id":"jest","executable":"npm","args":["test","--","--runInBand","tests/runtime/(automation|openhands|development|codex-evaluator|verification-authorities|langgraph-local|model-egress-proxy|service-rate-limit)"],"timeout_ms":300000}]'
