# RONOR v1.0 — Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# CORE — OpenAI (Required)
# ============================================================
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL_PRIMARY=gpt-4o          # Primary inference model
OPENOR_MODEL_FABRIC_ENGINE=gpt-4o    # R-Model Fabric core engine
OPENAI_ORG_ID=                       # Optional: your org ID

# ============================================================
# SERVER
# ============================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
RONOR_VERSION=1.0.0

# ============================================================
# R-GATEWAY — API Security
# ============================================================
GATEWAY_API_KEY=ronor-dev-key-change-in-production
JWT_SECRET=change-this-to-a-secure-random-string
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# ============================================================
# R-CONTEXT — Context Management
# ============================================================
CONTEXT_MAX_TOKENS=128000
CONTEXT_COMPRESSION_THRESHOLD=0.8
CONTEXT_CACHE_TTL_SECONDS=3600

# ============================================================
# R-MODEL FABRIC — Model Routing
# ============================================================
MODEL_FABRIC_STRATEGY=ems           # ems | cost | latency | quality
MODEL_FABRIC_FALLBACK_ENABLED=true
MODEL_FABRIC_TIMEOUT_MS=30000

# ============================================================
# R-AGENT RUNTIME — Agent Orchestration
# ============================================================
AGENT_MAX_CONCURRENT=10
AGENT_MAX_ITERATIONS=25
AGENT_TIMEOUT_MS=120000

# ============================================================
# R-EXECUTION — Execution Engine
# ============================================================
EXECUTION_SANDBOX_ENABLED=true
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_DELAY_MS=1000

# ============================================================
# R-ASSURANCE — Quality & Evidence
# ============================================================
ASSURANCE_EVIDENCE_STORE=memory     # memory | redis | postgres
ASSURANCE_MIN_CONFIDENCE=0.7
ASSURANCE_AUDIT_LOG_ENABLED=true

# ============================================================
# R-ECONOMICS — EMS Scoring
# ============================================================
ECONOMICS_EMS_QUALITY_WEIGHT=0.35
ECONOMICS_EMS_COST_WEIGHT=0.25
ECONOMICS_EMS_LATENCY_WEIGHT=0.20
ECONOMICS_EMS_RISK_WEIGHT=0.10
ECONOMICS_EMS_SOVEREIGNTY_WEIGHT=0.05
ECONOMICS_EMS_EVIDENCE_WEIGHT=0.05

# ============================================================
# R-SENTINEL — Operational Resource Intelligence (MIP-013)
# ============================================================
SENTINEL_ENABLED=true
SENTINEL_INTERVAL_MS=5000
SENTINEL_BUFFER_WINDOW_MS=300000        # 5-minute metric retention window
SENTINEL_HYSTERESIS_BREACHES=3          # consecutive breaches before alerting
SENTINEL_DEGRADATION_ENABLED=false      # policy gate for the degradation ladder
SENTINEL_MAX_DEGRADATION_LEVEL=8        # ladder ceiling (1–8, all reversible)
SENTINEL_STORAGE_MOUNT=/                # mount point probed via `df -k`
SENTINEL_MAX_SESSIONS=1000              # context-session capacity reference
SENTINEL_MAX_TOKENS_PER_SECOND=20000    # token-throughput capacity reference
SENTINEL_LATENCY_BUDGET_MS=30000        # inference-latency budget reference

# ============================================================
# R-KNOWLEDGE — Governed Knowledge Intelligence
# MIP-014 (plane) + MIP-015 (real services)
#
# Default: DISABLED. The plane performs no action whatsoever
# unless KNOWLEDGE_ENABLED is exactly the string "true".
# Every value below is the SAFE value. A deployment that copies
# this file unchanged gets no plane, no routes and no egress.
# ============================================================
KNOWLEDGE_ENABLED=false                     # master switch; fail-closed
KNOWLEDGE_VECTOR_STORE=sqlite               # sqlite | qdrant | none
KNOWLEDGE_SQLITE_PATH=./data/knowledge.db   # local reference store; gitignored
KNOWLEDGE_EMBEDDING_DIMENSIONS=384          # contract dimension; provider must match
KNOWLEDGE_EXTERNAL_EGRESS_AUTHORISED=false  # hard gate on ALL network egress
KNOWLEDGE_MAX_CLASSIFICATION=INTERNAL       # PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
KNOWLEDGE_CHUNK_SIZE_TOKENS=512             # deterministic chunker target
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=64           # deterministic chunker overlap
KNOWLEDGE_RETRIEVAL_TOP_K=8                 # default K for retrieval
KNOWLEDGE_MIN_SIMILARITY=0.25               # zero-result floor
KNOWLEDGE_RAG_ENABLED=false                 # RAG composition; subordinate to master switch
KNOWLEDGE_RAG_MIN_SOURCES=2                 # sufficiency threshold for generation
KNOWLEDGE_QUARANTINE_PATH=./data/knowledge-quarantine.jsonl
KNOWLEDGE_ENVIRONMENT_CLASS=                # ci | test | development | production (inferred when empty)

# --- EMBEDDING PROVIDER ---------------------------------------------------
# deterministic  reproducible hashed projection; NO egress, NO credential.
#                Suitable for CI and for verifying the plane end to end.
#                Captures lexical overlap and little semantic structure.
# openai         learned model over the OpenAI embeddings API. Requires
#                KNOWLEDGE_EXTERNAL_EGRESS_AUTHORISED=true, an absolute https
#                endpoint, an API key and an explicitly named model. Six
#                conditions precedent are evaluated BEFORE any client is
#                constructed; if any fails, no client exists and no request is
#                possible.
KNOWLEDGE_EMBEDDING_PROVIDER=deterministic  # deterministic | openai | local | external
KNOWLEDGE_OPENAI_BASE_URL=                  # MUST be absolute https. NO DEFAULT: a
                                            # default endpoint would mean egress to a
                                            # destination nobody chose.
KNOWLEDGE_OPENAI_API_KEY=                   # never logged, never in health output
KNOWLEDGE_OPENAI_MODEL=                     # NO VENDOR DEFAULT — name it explicitly
                                            # e.g. text-embedding-3-small (1536 dims)
KNOWLEDGE_OPENAI_TIMEOUT_MS=10000
KNOWLEDGE_OPENAI_MAX_RETRIES=2               # 5xx/429 retried; 401/403 never retried
KNOWLEDGE_OPENAI_BATCH_SIZE=64
KNOWLEDGE_OPENAI_FALLBACK=true               # on learned-provider failure, fall back to
                                             # the deterministic embedder. A fallback
                                             # vector is ALWAYS labelled
                                             # provider=deterministic, never openai, so a
                                             # later re-embedding pass can find it.

# --- QDRANT (production vector store, authorised by MIP-015) --------------
# SQLite remains PROHIBITED in production: where no authorised production store
# is configured the plane enters degradation level 3 and creates no local database.
#
# Both naming conventions are honoured. KNOWLEDGE_QDRANT_* takes precedence over
# the shorter QDRANT_* form when both are present.
QDRANT_URL=                                 # e.g. http://qdrant:6333 (compose profile)
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ronor_knowledge      # collection = access-control unit
KNOWLEDGE_QDRANT_ENDPOINT=                  # equivalent to QDRANT_URL; takes precedence
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_QDRANT_COLLECTION=ronor_knowledge
KNOWLEDGE_QDRANT_TIMEOUT_MS=2000
KNOWLEDGE_QDRANT_MAX_RETRIES=2
KNOWLEDGE_QDRANT_ENVIRONMENT_AUTHORISATION=  # authorisation reference for this environment
KNOWLEDGE_QDRANT_AUTO_CREATE_COLLECTION=false # DISABLED by default. When false a missing
                                              # collection REFUSES rather than being
                                              # provisioned: silently creating storage
                                              # nobody asked for is how a typo in a
                                              # collection name becomes an empty corpus
                                              # that appears to work.
KNOWLEDGE_QDRANT_DISTANCE=Cosine             # Cosine | Dot | Euclid
QDRANT__TELEMETRY_DISABLED=true               # SERVER-side setting; effective only where
                                              # the server is operated (see docker-compose)

# --- Legacy / generic embedding keys (retained; still inert) --------------
KNOWLEDGE_EMBEDDING_ENDPOINT=               # generic provider endpoint
KNOWLEDGE_EMBEDDING_MODEL=                  # NO VENDOR DEFAULT — deliberately empty

# ============================================================
# OPTIONAL — Redis (for production caching)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ============================================================
# OPTIONAL — PostgreSQL (for audit log persistence)
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/ronor
DATABASE_ENABLED=false

# ============================================================
# ============================================================
# RUNTIME ACTIVE (v0.5.0) — L0 · L1 · L3 · L7
# ============================================================
# ============================================================
#
# Everything below is additive. A deployment that sets none of it keeps the
# Core Active behaviour: the runtime surface boots with no API keys, refuses
# every authenticated call with 401, and REPORTS that state on /health rather
# than quietly admitting traffic.

# ------------------------------------------------------------
# RUNTIME API AUTHENTICATION (L0)
# ------------------------------------------------------------
#
# There is no default credential. A runtime with no key configured is unusable
# by design: the alternative is a shipped secret that reaches production because
# nobody remembered it existed.
#
# Keys are stored HASHED (SHA-256). A stolen database yields no usable
# credential, and the plaintext cannot be recovered from this system — if you
# lose it, issue a new one.

# Full-scope credential: query, agent, read, admin, ingest.
# Generate with:  openssl rand -hex 32
RONOR_ADMIN_API_KEY=

# Operator credentials, comma-separated `label:secret` pairs. Role `operator`
# receives query + agent + read. It CANNOT reach /admin/*, and that refusal is a
# 403 naming the scope it lacked rather than a silent no-op.
#   RONOR_API_KEYS=control-room:6f2c...,analyst-desk:9a71...
RONOR_API_KEYS=

# Per-key request ceiling, requests per minute. Enforced PER INSTANCE, not
# cluster-wide — behind a load balancer the effective limit is this value times
# the instance count. Stated plainly because a limit believed to be global while
# it is per-process is a limit that does not exist.
RONOR_RATE_LIMIT_RPM=60

# This exact value is the shipped placeholder:
#   ronor-dev-key-change-in-production
# If it is ever active the runtime logs an error on every boot and /health
# reports `insecure-default-key` in security_findings. Silence about a default
# credential is how a demonstration system reaches production.

# ------------------------------------------------------------
# L1 MODEL EXCHANGE — PROVIDER CREDENTIALS
# ------------------------------------------------------------
#
# Two-tier resolution per provider:
#   1. NATIVE  — a vendor key below is present, so the adapter calls that
#                vendor's own API directly.
#   2. GATEWAY — no vendor key, but OPENAI_API_BASE points at an
#                OpenAI-compatible multi-provider endpoint, so the adapter
#                routes through it.
#
# With neither, the provider reports `key-absent`. Its adapter is fully
# implemented and the router simply will not select it: P0_CREDENTIAL_REALITY
# excludes it BEFORE scoring, so "eligible" always means "would actually
# execute". Absent providers are named on /health rather than hidden, because a
# runtime that silently drops a provider looks identical to one that never had
# it configured.

# --- OpenAI-compatible gateway (optional, shared fallback) ----------------
OPENAI_API_BASE=

# --- OpenAI ---------------------------------------------------------------
# OPENAI_API_KEY is declared in the CORE section above and is reused here.
# Models: gpt-5.5, gpt-5, gpt-5-mini, gpt-5-nano
#
# NOTE ON A REAL TRAP: the GPT-5 family requires `max_completion_tokens`, while
# Anthropic and Google require `max_tokens`. Sending the wrong one returns
# HTTP 200 with an EMPTY answer rather than an error — the worst failure mode
# for a runtime that writes results to an audit chain. The adapters handle this
# per family and the tests assert the emitted REQUEST BODY, not the returned
# text: a test that only checked for a non-empty response would pass against a
# mock and fail against the vendor.

# --- Anthropic ------------------------------------------------------------
# Native: https://api.anthropic.com/v1/messages
# Models: claude-opus-4-7, claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_VERSION=2023-06-01

# --- Google Gemini --------------------------------------------------------
# Native: generativelanguage.googleapis.com
# Models: gemini-3.1-pro-preview, gemini-3-flash-preview
GEMINI_API_KEY=
GEMINI_BASE_URL=

# --- DeepSeek -------------------------------------------------------------
# Native: https://api.deepseek.com (OpenAI-compatible wire format)
# Models: deepseek-chat, deepseek-reasoner
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# --- Perplexity -----------------------------------------------------------
# Native: https://api.perplexity.ai (OpenAI-compatible wire format)
# Models: sonar-pro, sonar
#
# The ONLY catalogued models declaring the `search` capability, because they are
# the only ones performing live retrieval during generation. With no key here, a
# request whose task_type is `search` is REFUSED by P2_CAPABILITY_MATCH rather
# than routed to a model that cannot search. That refusal is deliberate: a
# confident answer from a model with no retrieval is worse than a clear failure.
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=

# --- Request timeout applied to every provider call ----------------------
RUNTIME_PROVIDER_TIMEOUT_MS=120000

# ------------------------------------------------------------
# L1 ROUTER — 6D SCORING WEIGHTS
# ------------------------------------------------------------
#
# Six dimensions, normalised to sum to 1. Quality is multiplied by each engine's
# MEASURED success rate, so a provider that begins failing loses traffic without
# anyone editing a weight.
#
# Latency and cost are scored from OBSERVED p50 over a rolling window; the
# catalogue seed is used only until real samples exist, and the two are
# distinguished in every response (`latency_observed`) so a seeded estimate is
# never mistaken for a measurement.
RUNTIME_WEIGHT_QUALITY=0.35
RUNTIME_WEIGHT_COST=0.25
RUNTIME_WEIGHT_LATENCY=0.20
RUNTIME_WEIGHT_RISK=0.10
RUNTIME_WEIGHT_SOVEREIGNTY=0.05
RUNTIME_WEIGHT_EVIDENCE=0.05

# Rolling window size per model for latency/success calibration.
RUNTIME_TELEMETRY_WINDOW=50

# Maximum engines tried before a request is declared failed. The chain stops at
# the first success; every attempt, INCLUDING the failures, is written to the
# ledger with its cost, because a request that succeeded on its second engine
# spent money on two.
RUNTIME_MAX_FALLBACK_ATTEMPTS=3

# ------------------------------------------------------------
# L3 MULTI-AGENT RUNTIME
# ------------------------------------------------------------
#
# Default ceiling on one mission's total spend, USD. When reached, the mission
# HALTS BETWEEN TASKS and returns `partial` with its gaps declared. Completing
# silently over budget would be the worse failure.
RUNTIME_MISSION_MAX_COST_USD=2.00

# Maximum tasks in one decomposition. The planner's output is VALIDATED, never
# trusted: unknown agents dropped, dangling dependencies removed, and cycles
# BROKEN rather than merely detected — a coordinator waiting forever on a cyclic
# plan cannot be recovered by an operator.
RUNTIME_MISSION_MAX_TASKS=6

# Wall-clock ceiling for one worker's turn.
RUNTIME_AGENT_TIMEOUT_MS=180000

# Outbound fetch budget for the `web.fetch` tool, in bytes.
RUNTIME_FETCH_MAX_BYTES=2000000

# `web.fetch` ALWAYS refuses loopback, RFC1918 private ranges, link-local and
# cloud metadata endpoints (169.254.169.254 and equivalents). This is NOT
# configurable. Without it, a model persuaded to fetch a URL reads the instance
# metadata service and exfiltrates cloud credentials — materially worse than any
# wrong answer it could produce.

# ------------------------------------------------------------
# L7 OPERATIONAL LEDGERS
# ------------------------------------------------------------
#
# Written to the same SQLite database as the audit chain (AUDIT_DB_PATH above),
# so a request's ledger row and its audit record commit or fail together. Two
# separate files could disagree about whether work happened.
#
# The prompt itself is NEVER stored — only a SHA-256 digest, which proves two
# requests were identical without the ledger holding their content.

# Retain ledger rows for this many days. 0 disables pruning.
# Pruning NEVER touches the audit chain: a hash chain with rows removed no
# longer verifies, and an unverifiable chain is worth less than no chain.
RUNTIME_LEDGER_RETENTION_DAYS=0

# ------------------------------------------------------------
# OPERATOR CONSOLE
# ------------------------------------------------------------
#
# Served at /console from static files. No build step, so nothing sits between
# the source and the browser at the moment someone needs to read a cost figure.
# It holds no credential of its own: the operator pastes a key, it is kept in
# sessionStorage only (not localStorage — a credential that survives the tab is
# one left behind on a shared machine), and it is sent as a bearer token like
# any other client.
RUNTIME_CONSOLE_ENABLED=true
