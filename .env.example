# RONOR v1.0 — Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# CORE — OpenAI (Required)
# ============================================================
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL_PRIMARY=gpt-4o          # Primary inference model
OPENOR_MODEL_FABRIC_ENGINE=gpt-4o    # R-Model Fabric core engine
OPENAI_ORG_ID=                       # Optional: your org ID

# ============================================================
# SERVER
# ============================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
RONOR_VERSION=1.0.0

# ============================================================
# R-GATEWAY — API Security
# ============================================================
GATEWAY_API_KEY=ronor-dev-key-change-in-production
JWT_SECRET=change-this-to-a-secure-random-string
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# ============================================================
# R-CONTEXT — Context Management
# ============================================================
CONTEXT_MAX_TOKENS=128000
CONTEXT_COMPRESSION_THRESHOLD=0.8
CONTEXT_CACHE_TTL_SECONDS=3600

# ============================================================
# R-MODEL FABRIC — Model Routing
# ============================================================
MODEL_FABRIC_STRATEGY=ems           # ems | cost | latency | quality
MODEL_FABRIC_FALLBACK_ENABLED=true
MODEL_FABRIC_TIMEOUT_MS=30000

# ============================================================
# R-AGENT RUNTIME — Agent Orchestration
# ============================================================
AGENT_MAX_CONCURRENT=10
AGENT_MAX_ITERATIONS=25
AGENT_TIMEOUT_MS=120000

# ============================================================
# R-EXECUTION — Execution Engine
# ============================================================
EXECUTION_SANDBOX_ENABLED=true
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_DELAY_MS=1000

# ============================================================
# R-ASSURANCE — Quality & Evidence
# ============================================================
ASSURANCE_EVIDENCE_STORE=memory     # memory | redis | postgres
ASSURANCE_MIN_CONFIDENCE=0.7
ASSURANCE_AUDIT_LOG_ENABLED=true

# ============================================================
# R-ECONOMICS — EMS Scoring
# ============================================================
ECONOMICS_EMS_QUALITY_WEIGHT=0.35
ECONOMICS_EMS_COST_WEIGHT=0.25
ECONOMICS_EMS_LATENCY_WEIGHT=0.20
ECONOMICS_EMS_RISK_WEIGHT=0.10
ECONOMICS_EMS_SOVEREIGNTY_WEIGHT=0.05
ECONOMICS_EMS_EVIDENCE_WEIGHT=0.05

# ============================================================
# R-SENTINEL — Operational Resource Intelligence (MIP-013)
# ============================================================
SENTINEL_ENABLED=true
SENTINEL_INTERVAL_MS=5000
SENTINEL_BUFFER_WINDOW_MS=300000        # 5-minute metric retention window
SENTINEL_HYSTERESIS_BREACHES=3          # consecutive breaches before alerting
SENTINEL_DEGRADATION_ENABLED=false      # policy gate for the degradation ladder
SENTINEL_MAX_DEGRADATION_LEVEL=8        # ladder ceiling (1–8, all reversible)
SENTINEL_STORAGE_MOUNT=/                # mount point probed via `df -k`
SENTINEL_MAX_SESSIONS=1000              # context-session capacity reference
SENTINEL_MAX_TOKENS_PER_SECOND=20000    # token-throughput capacity reference
SENTINEL_LATENCY_BUDGET_MS=30000        # inference-latency budget reference

# ============================================================
# R-KNOWLEDGE — Governed Knowledge Intelligence
# MIP-014 (plane) + MIP-015 (real services)
#
# Default: DISABLED. The plane performs no action whatsoever
# unless KNOWLEDGE_ENABLED is exactly the string "true".
# Every value below is the SAFE value. A deployment that copies
# this file unchanged gets no plane, no routes and no egress.
# ============================================================
KNOWLEDGE_ENABLED=false                     # master switch; fail-closed
KNOWLEDGE_VECTOR_STORE=sqlite               # sqlite | qdrant | none
KNOWLEDGE_SQLITE_PATH=./data/knowledge.db   # local reference store; gitignored
KNOWLEDGE_EMBEDDING_DIMENSIONS=384          # contract dimension; provider must match
KNOWLEDGE_EXTERNAL_EGRESS_AUTHORISED=false  # hard gate on ALL network egress
KNOWLEDGE_MAX_CLASSIFICATION=INTERNAL       # PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
KNOWLEDGE_CHUNK_SIZE_TOKENS=512             # deterministic chunker target
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=64           # deterministic chunker overlap
KNOWLEDGE_RETRIEVAL_TOP_K=8                 # default K for retrieval
KNOWLEDGE_MIN_SIMILARITY=0.25               # zero-result floor
KNOWLEDGE_RAG_ENABLED=false                 # RAG composition; subordinate to master switch
KNOWLEDGE_RAG_MIN_SOURCES=2                 # sufficiency threshold for generation
KNOWLEDGE_QUARANTINE_PATH=./data/knowledge-quarantine.jsonl
KNOWLEDGE_ENVIRONMENT_CLASS=                # ci | test | development | production (inferred when empty)

# --- EMBEDDING PROVIDER ---------------------------------------------------
# deterministic  reproducible hashed projection; NO egress, NO credential.
#                Suitable for CI and for verifying the plane end to end.
#                Captures lexical overlap and little semantic structure.
# openai         learned model over the OpenAI embeddings API. Requires
#                KNOWLEDGE_EXTERNAL_EGRESS_AUTHORISED=true, an absolute https
#                endpoint, an API key and an explicitly named model. Six
#                conditions precedent are evaluated BEFORE any client is
#                constructed; if any fails, no client exists and no request is
#                possible.
KNOWLEDGE_EMBEDDING_PROVIDER=deterministic  # deterministic | openai | local | external
KNOWLEDGE_OPENAI_BASE_URL=                  # MUST be absolute https. NO DEFAULT: a
                                            # default endpoint would mean egress to a
                                            # destination nobody chose.
KNOWLEDGE_OPENAI_API_KEY=                   # never logged, never in health output
KNOWLEDGE_OPENAI_MODEL=                     # NO VENDOR DEFAULT — name it explicitly
                                            # e.g. text-embedding-3-small (1536 dims)
KNOWLEDGE_OPENAI_TIMEOUT_MS=10000
KNOWLEDGE_OPENAI_MAX_RETRIES=2               # 5xx/429 retried; 401/403 never retried
KNOWLEDGE_OPENAI_BATCH_SIZE=64
KNOWLEDGE_OPENAI_FALLBACK=true               # on learned-provider failure, fall back to
                                             # the deterministic embedder. A fallback
                                             # vector is ALWAYS labelled
                                             # provider=deterministic, never openai, so a
                                             # later re-embedding pass can find it.

# --- QDRANT (production vector store, authorised by MIP-015) --------------
# SQLite remains PROHIBITED in production: where no authorised production store
# is configured the plane enters degradation level 3 and creates no local database.
#
# Both naming conventions are honoured. KNOWLEDGE_QDRANT_* takes precedence over
# the shorter QDRANT_* form when both are present.
QDRANT_URL=                                 # e.g. http://qdrant:6333 (compose profile)
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ronor_knowledge      # collection = access-control unit
KNOWLEDGE_QDRANT_ENDPOINT=                  # equivalent to QDRANT_URL; takes precedence
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_QDRANT_COLLECTION=ronor_knowledge
KNOWLEDGE_QDRANT_TIMEOUT_MS=2000
KNOWLEDGE_QDRANT_MAX_RETRIES=2
KNOWLEDGE_QDRANT_ENVIRONMENT_AUTHORISATION=  # authorisation reference for this environment
KNOWLEDGE_QDRANT_AUTO_CREATE_COLLECTION=false # DISABLED by default. When false a missing
                                              # collection REFUSES rather than being
                                              # provisioned: silently creating storage
                                              # nobody asked for is how a typo in a
                                              # collection name becomes an empty corpus
                                              # that appears to work.
KNOWLEDGE_QDRANT_DISTANCE=Cosine             # Cosine | Dot | Euclid
QDRANT__TELEMETRY_DISABLED=true               # SERVER-side setting; effective only where
                                              # the server is operated (see docker-compose)

# --- Legacy / generic embedding keys (retained; still inert) --------------
KNOWLEDGE_EMBEDDING_ENDPOINT=               # generic provider endpoint
KNOWLEDGE_EMBEDDING_MODEL=                  # NO VENDOR DEFAULT — deliberately empty

# ============================================================
# OPTIONAL — Redis (for production caching)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ============================================================
# OPTIONAL — PostgreSQL (for audit log persistence)
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/ronor
DATABASE_ENABLED=false
