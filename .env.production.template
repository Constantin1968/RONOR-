# ============================================================================
# RONOR v0.5.0 — .env.production
# ----------------------------------------------------------------------------
# Copy to `.env.production` on the server, fill every REQUIRED value, then:
#
#   chmod 600 .env.production
#
# This file is the single place credentials exist on the host. It is listed in
# .gitignore and .dockerignore; the template is the only version that is
# committed. A secret in git history is a secret that has been published.
#
# Legend
#   [REQUIRED]  the runtime refuses to start, or refuses every request, without it
#   [STRONGLY]  the runtime starts but a named capability is degraded or absent
#   [OPTIONAL]  tuning; the documented default is sane
#
# Generate every secret marked <generate> with:
#   openssl rand -hex 32
#
# Prepared by AMB · Mayleven Ecosystem
# ============================================================================

# ----------------------------------------------------------------------------
# 0 · RELEASE
# ----------------------------------------------------------------------------
RONOR_VERSION=0.5.0
NODE_ENV=production
PORT=3000
# Public origin, used for absolute links in operator-facing output. No trailing slash.
RONOR_PUBLIC_URL=https://ronor.example.com

# ----------------------------------------------------------------------------
# 1 · RUNTIME API CREDENTIALS  [REQUIRED]
# ----------------------------------------------------------------------------
#
# Format:  label:role:scopes|secret  (comma-separated for multiple keys)
#   roles:  admin | operator | readonly
#   scopes: query, read, agent, ingest, admin  (`*` for all)
#
# With no key set, the runtime API refuses EVERY request — that is the correct
# failure, not a bug. The shipped demo key is rejected in production and is
# reported on /api/runtime/health as a security finding if ever active.
RONOR_API_KEYS=telegram-bridge:operator:query,read,agent|<generate>,console:operator:query,read|<generate>
RONOR_ADMIN_API_KEY=<generate>
# Per-key request ceiling per minute. In-process, per instance — not a
# distributed quota. Stated plainly because the limiter says so in its own
# response headers.
RONOR_RATE_LIMIT_RPM=60
RONOR_ADMIN_RATE_LIMIT_RPM=120
RUNTIME_CONSOLE_ENABLED=true

# ----------------------------------------------------------------------------
# 2 · MODEL PROVIDERS  [STRONGLY — at least one]
# ----------------------------------------------------------------------------
#
# /api/runtime/health reports `ready` only when at least one GENERATIVE provider
# is invocable. With none, the runtime is live and governed but can answer only
# deterministically; the healthcheck in docker-compose.production.yml treats that
# as unhealthy on purpose, so the state cannot pass unnoticed.
#
# A key that is absent is not an error — the router's P0_CREDENTIAL_PRESENT
# predicate simply removes that provider from the eligible set and says so in
# every routing table it returns.
# Native OpenAI key. Gateway credentials use the separate variables below.
OPENAI_NATIVE_API_KEY=
OPENAI_BASE_URL=
RONOR_GATEWAY_BASE_URL=
RONOR_GATEWAY_API_KEY=
RONOR_GATEWAY_MODELS=
# Legacy gateway alias retained for compatibility with existing deployments.
OPENAI_API_KEY=
RONOR_GATEWAY_HEADERS=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Perplexity holds the ONLY models declaring the `search` capability. Without it,
# a request whose task_type is `search` is REFUSED by P2_CAPABILITY_MATCH rather
# than routed to a model that cannot search. That refusal is deliberate.
PERPLEXITY_API_KEY=
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.ai/v1
RUNTIME_PROVIDER_TIMEOUT_MS=120000

# 6D router weights — must sum to 1.
RUNTIME_WEIGHT_QUALITY=0.35
RUNTIME_WEIGHT_COST=0.25
RUNTIME_WEIGHT_LATENCY=0.20
RUNTIME_WEIGHT_RISK=0.10
RUNTIME_WEIGHT_SOVEREIGNTY=0.05
RUNTIME_WEIGHT_EVIDENCE=0.05
RUNTIME_TELEMETRY_WINDOW=50
RUNTIME_MAX_FALLBACK_ATTEMPTS=3

# ----------------------------------------------------------------------------
# 3 · MULTI-AGENT RUNTIME (L3)  [OPTIONAL]
# ----------------------------------------------------------------------------
# On reaching the ceiling a mission HALTS BETWEEN TASKS and returns `partial`
# with its gaps declared. Completing silently over budget is the worse failure.
RUNTIME_MISSION_MAX_COST_USD=2.00
RUNTIME_MISSION_MAX_TASKS=6
RUNTIME_AGENT_TIMEOUT_MS=180000
RUNTIME_FETCH_MAX_BYTES=2000000

# ----------------------------------------------------------------------------
# 4 · GOVERNANCE + AUDIT (L6/L7)
# ----------------------------------------------------------------------------
MI9_POLICY_PATH=/app/src/governance/policies.yaml
AUDIT_DB_PATH=/app/data/audit.db
# 0 disables pruning. Pruning NEVER touches the audit chain: a hash chain with
# rows removed no longer verifies, and an unverifiable chain is worth less than
# no chain at all.
RUNTIME_LEDGER_RETENTION_DAYS=0

# ----------------------------------------------------------------------------
# 5 · QDRANT — R-Knowledge vector store  [REQUIRED for knowledge]
# ----------------------------------------------------------------------------
KNOWLEDGE_ENABLED=true
KNOWLEDGE_VECTOR_STORE=qdrant
# Overridden to http://qdrant:6333 inside compose. This value applies when the
# runtime is executed outside the compose network.
KNOWLEDGE_QDRANT_ENDPOINT=http://127.0.0.1:6333
KNOWLEDGE_QDRANT_API_KEY=<generate>
KNOWLEDGE_QDRANT_COLLECTION=ronor_knowledge
KNOWLEDGE_QDRANT_AUTO_CREATE_COLLECTION=true
KNOWLEDGE_QDRANT_DISTANCE=Cosine
KNOWLEDGE_QDRANT_TIMEOUT_MS=2000
KNOWLEDGE_QDRANT_MAX_RETRIES=2
# The adapter refuses to address a non-loopback endpoint unless the environment
# class is stated explicitly. Inside compose the endpoint is a service name, so
# this must be set.
KNOWLEDGE_QDRANT_ENVIRONMENT_AUTHORISATION=container
KNOWLEDGE_ENVIRONMENT_CLASS=production
# Embeddings. text-embedding-3-small → 1536 dimensions. The dimension and the
# model must agree: a collection created at one width cannot accept vectors of
# another, and the mismatch surfaces as a write failure long after ingestion
# began.
KNOWLEDGE_EMBEDDING_PROVIDER=openai
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_OPENAI_API_KEY=
KNOWLEDGE_OPENAI_MODEL=text-embedding-3-small
KNOWLEDGE_OPENAI_BATCH_SIZE=64
KNOWLEDGE_OPENAI_TIMEOUT_MS=30000
KNOWLEDGE_OPENAI_MAX_RETRIES=2
# Set true ONLY when outbound calls to the embedding vendor are authorised for
# this deployment's data classification. It is false by default because an
# unreviewed egress path for INTERNAL material is a disclosure, not a feature.
KNOWLEDGE_EXTERNAL_EGRESS_AUTHORISED=false
KNOWLEDGE_MAX_CLASSIFICATION=INTERNAL
KNOWLEDGE_CHUNK_SIZE_TOKENS=512
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=64
KNOWLEDGE_RETRIEVAL_TOP_K=8
KNOWLEDGE_MIN_SIMILARITY=0.25
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_RAG_MIN_SOURCES=2
KNOWLEDGE_SQLITE_PATH=/app/data/knowledge.db
KNOWLEDGE_QUARANTINE_PATH=/app/data/knowledge-quarantine.jsonl
# Additional collections provisioned by scripts/provision-qdrant.ts.
RONOR_QDRANT_COLLECTION_MEMORY=ronor_memory
RONOR_QDRANT_COLLECTION_KNOWLEDGE=ronor_knowledge
RONOR_QDRANT_COLLECTION_MISSIONS=ronor_missions

# ----------------------------------------------------------------------------
# 6 · REDIS — approval state, idempotency, shared counters  [REQUIRED]
# ----------------------------------------------------------------------------
REDIS_PASSWORD=<generate>
# Inside compose the REDIS_URL is overridden to redis://:${REDIS_PASSWORD}@redis:6379
# automatically (see docker-compose.production.yml). Set this only when
# pointing at an external Redis instance outside the compose network.
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379

# ----------------------------------------------------------------------------
# 7 · SUPABASE — durable relational memory (L2)  [REQUIRED for persistence]
# ----------------------------------------------------------------------------
#
# The SERVICE ROLE key bypasses row-level security. It belongs on a server the
# operator controls and nowhere else — never in a browser, never in a mobile
# bundle, never in a repository.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct Postgres connection, used only by the migration runner.
# postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
SUPABASE_SCHEMA=ronor
# Fail closed or degrade? `false` means a Supabase outage degrades RONOR to
# in-memory + SQLite and SAYS SO in every response, rather than refusing all
# work. Set true where a query that cannot be persisted must not be answered.
PERSISTENCE_REQUIRED=false

# ----------------------------------------------------------------------------
# 8 · CLOUDFLARE R2 — evidence object store (L6)  [STRONGLY]
# ----------------------------------------------------------------------------
#
# Holds evidence bundles and full transcripts: the payloads too large for a
# Postgres row, addressed by SHA-256 so that a stored artefact can be proven
# identical to the one the audit chain recorded.
R2_ACCOUNT_ID=
R2_BUCKET=ronor-evidence
# S3-compatible credentials, created in the Cloudflare dashboard under
# R2 → Manage API tokens. These are NOT the global API key.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
# Optional public read domain for evidence links. Leave blank to keep the
# bucket entirely private, which is the default and the safer posture.
R2_PUBLIC_BASE_URL=

# ----------------------------------------------------------------------------
# 9 · TELEGRAM OPERATOR INTERFACE  [REQUIRED for the telegram profile]
# ----------------------------------------------------------------------------
#
# From @BotFather. Treat as a credential: the token IS the bot.
TELEGRAM_BOT_TOKEN=
# ALLOWLIST — numeric Telegram user ids, comma-separated. An EMPTY allowlist
# means the bot answers NOBODY. That is deliberate: a governed runtime reachable
# by any stranger who finds the bot handle is not governed, and defaulting to
# open would make the first misconfiguration the last one that mattered.
TELEGRAM_ALLOWED_USER_IDS=
# Chairman ids — the only accounts whose /approve or /reject settles a Gate 1/2
# co-sign request. Must be a subset of the allowlist.
TELEGRAM_APPROVER_USER_IDS=
# Optional chat that receives unsolicited co-sign requests and alerts.
TELEGRAM_CONTROL_CHAT_ID=
# Long polling (default) needs no inbound port and no TLS — the correct choice
# for a Tailscale-only host. Webhook mode requires a public HTTPS endpoint.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
# Random path segment, so an unauthenticated scan cannot find the webhook.
TELEGRAM_WEBHOOK_SECRET=<generate>
# Minutes a pending approval remains actionable. It EXPIRES rather than waiting
# forever: an approval answered three days later approves a decision whose
# context has gone.
TELEGRAM_APPROVAL_TTL_MINUTES=60
TELEGRAM_MAX_MESSAGE_CHARS=3800

# ----------------------------------------------------------------------------
# 10 · TAILSCALE — sovereign private plane  [OPTIONAL]
# ----------------------------------------------------------------------------
#
# An auth key (tskey-auth-...) joins the host to the tailnet. The API key
# (tskey-api-...) is for the control-plane REST API and is NOT interchangeable
# with it — `tailscale up` will reject an API key.
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=ronor-runtime
TAILSCALE_TAILNET=-
# Optional peer used by connectivity checks. Prefer a stable MagicDNS name.
TAILSCALE_PEER_HOSTNAME=
TAILSCALE_PEER_IP=
# Control-plane key. Only needed by scripts that enumerate or authorise devices.
TAILSCALE_API_KEY=
# Restrict egress to the tailnet only. When true the runtime refuses outbound
# calls to any address outside 100.64.0.0/10 — a hard sovereignty posture, and
# incompatible with vendor model APIs.
RONOR_EGRESS_TAILNET_ONLY=false

# ----------------------------------------------------------------------------
# 10A · GOVERNED DEVELOPMENT AUTOMATION  [OPT-IN]
# ----------------------------------------------------------------------------
# These service-DNS endpoints are valid only when the runtime is launched with
# docker-compose.automation-runtime.yml on the pre-created internal network.
RONOR_AUTOMATION_ENABLED=false
RONOR_AUTOMATION_RUNTIME_BASE_IMAGE=ronor:<verified-release-tag>
RONOR_AUTOMATION_IMAGE_TAG=<immutable-activation-tag>
RONOR_LANGGRAPH_URL=http://langgraph:2024
RONOR_LANGGRAPH_TOKEN=
RONOR_OPENHANDS_URL=http://openhands-bridge:3001
RONOR_OPENHANDS_TOKEN=
RONOR_CODEX_VERIFIER_URL=http://codex-verifier:3002
RONOR_CODEX_VERIFIER_TOKEN=
RONOR_ASSURANCE_URL=http://victoria-assurance:3003
RONOR_ASSURANCE_TOKEN=
RONOR_AUTOMATION_CAPABILITY_KEY=
RONOR_AUTOMATION_WORKSPACE_ROOT=/automation-worktrees
RONOR_AUTOMATION_WORKTREE=/automation-worktrees/project
RONOR_AUTOMATION_BRANCH=automation/live
RONOR_AUTOMATION_ARTIFACT_ROOT=/automation-artifacts
RONOR_AUTOMATION_EXPECTED_ORIGIN=https://github.com/Constantin1968/RONOR-.git
RONOR_AUTOMATION_EXPECTED_HEAD=
RONOR_AUTOMATION_TEST_COMMANDS_JSON=[]
RONOR_AUTOMATION_MAX_COST_USD=5
RONOR_AUTOMATION_MAX_RUNTIME_MINUTES=60
RONOR_AUTOMATION_MAX_FIX_CYCLES=3
# OpenAI Responses-compatible endpoint used only by the independent verifier.
# The automation env may point this at the already governed RONOR gateway.
RONOR_CODEX_BASE_URL=https://api.openai.com/v1
RONOR_MODEL_GATEWAY_BASE_URL=https://approved-model-gateway.example/v1

# ----------------------------------------------------------------------------
# 11 · TLS EDGE (nginx profile)  [REQUIRED when profile `edge` is used]
# ----------------------------------------------------------------------------
RONOR_DOMAIN=ronor.example.com
CERTBOT_EMAIL=
QDRANT_LOG_LEVEL=INFO
