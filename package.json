    "@types/jsonwebtoken": "^9.0.6",
    "@types/pg": "^8.11.6",
    "@types/jest": "^29.5.12",
    "typescript": "^5.5.3",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "eslint": "^9.7.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
