{
  "name": "ronor-model-exchange-governance-spine",
  "version": "2.0.0-build-week",
  "description": "RONOR — Model Exchange & Governance Spine for Energy Operations. A 6D model router, MI9 governance gate, R-Assurance evidence layer, SHA-256 audit chain, and Work + Cost of Intelligence ledgers — wired end-to-end for a 20 MWh BESS Romania scenario.",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "automation:langgraph": "ts-node src/runtime/automation/services/langgraph-local.ts",
    "automation:openhands-bridge": "ts-node src/runtime/automation/services/openhands-bridge-server.ts",
    "automation:codex-verifier": "ts-node src/runtime/automation/services/verification-authorities-server.ts codex",
    "automation:assurance": "ts-node src/runtime/automation/services/verification-authorities-server.ts assurance",
    "build": "tsc",
    "postbuild": "cp -r web dist/ 2>/dev/null || true && mkdir -p dist/governance && cp src/governance/policies.yaml dist/governance/ 2>/dev/null || true",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:governance": "jest tests/governance",
    "test:audit": "jest tests/audit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node scripts/seed.ts",
    "benchmark": "ts-node scripts/benchmark.ts",
    "verify-chain": "ts-node scripts/verify-chain.ts",
    "ci": "npm run build && npm test && npm audit --audit-level=critical",
    "build:check": "tsc --noEmit",
    "checksum": "bash scripts/generate-checksums.sh"
  },
  "keywords": [
    "governance",
    "ai-governance",
    "audit-chain",
    "energy",
    "bess",
    "opcom",
    "vpp",
    "gpt-5.6",
    "codex",
    "eu-ai-act",
    "work-productivity",
    "mi9-gate",
    "sovereign-ai",
    "model-exchange",
    "model-router",
    "r-assurance",
    "work-ledger"
  ],
  "author": "Constantin Liviu NITA (Merlin) · Ma11AI · Mayleven Ecosystem (Mayleven Ltd, Company No. 17000500, England & Wales)",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@qdrant/js-client-rest": "1.18.0",
    "better-sqlite3": "^11.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "openai": "^4.55.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.7.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
