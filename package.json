  "author": "Ma11AI · Mayleven Ecosystem (Mayleven Ltd, Company No. 17000500, England & Wales)",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.55.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "winston": "^3.13.0",
    "prom-client": "^15.1.3",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.7.3",
    "p-queue": "^8.0.1",
    "lru-cache": "^11.0.0"
  },
  "devDependencies": {
