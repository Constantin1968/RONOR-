    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "llm",
    "runtime",
    "sovereignty",
    "openai",
    "gpt-5",
    "agent",
    "orchestration",
    "developer-tools"
