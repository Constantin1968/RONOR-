# Copy to .env and fill in. Never commit .env.

# --- Runtime ---------------------------------------------------------------
ET_SCHEDULER_ENABLED=true
ET_TIMEZONE=Europe/Bucharest
ET_HOME_ZONE=RO
ET_DATA_DIR=data
ET_STATE_DIR=state

# Daily job hours (local time, ET_TIMEZONE)
ET_WEATHER_HOUR=6
ET_HUB_RUN_HOUR=9
ET_EVENING_HOUR=18

# 24/7 watch between the daily jobs
ET_WATCH_MINUTES=1          # new NTC/prices/chat decisions → affected day recomputed
ET_SETTLE_MINUTES=60        # delivered hours settled, realised P&L reported
ET_GATE_CLOSURE=13:00       # day-ahead gate (SDAC 12:00 CET = 13:00 Bucharest)
ET_GATE_REMINDERS=60,15     # minutes before the gate to remind about unauthorized proposals
ET_RETRY_MINUTES=10         # failed job → retry interval
ET_MAX_RETRIES=3            # then escalate once
ET_HEARTBEAT_MINUTES=60
# Digital twin: published prices pulled from OPCOM / OREE+NBU (0 disables), P/L report hour
ET_FETCH_MINUTES=15
ET_PNL_HOUR=7

# Alert thresholds
ET_ALERT_CONCENTRATION=0.6
ET_ALERT_BASIS_EUR=40

# --- Telegram (bot created via @BotFather) ---------------------------------
# Token of the bot that posts alerts and reads the trading group
TELEGRAM_BOT_TOKEN=
# Chat id where alerts are sent (the trading group or a private channel)
TELEGRAM_CHAT_ID=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat ids allowed to feed the agent (empty = any chat)
TELEGRAM_ALLOWED_CHATS=

# --- Integrare cu nodul RONOR existent ---------------------------------------
# Secret pentru apelurile dispatcher-ului RONOR către /api/operator și /api/ops-upload
# (header X-RONOR-Token). Gol = deschis (doar local/dev).
ET_API_TOKEN=
# LLM suveran: Ollama de pe nodul Contabo. Gol = răspunsuri doar deterministe.
OLLAMA_URL=
# 'ronor-energy' = modelul creat de ronor/install.sh (doctrina în SYSTEM, peste OLLAMA_BASE)
OLLAMA_MODEL=ronor-energy
OLLAMA_TIMEOUT=120
